# Copy to .env (never commit it: it holds the association's key).

# The client key the EINUNDZWANZIG association issued for this server.
# Empty means the sidecar runs, but MyEditor offers the association's
# website instead of joining in the app.
E21_API_KEY=

# The public name of this server, for the HTTPS certificate (Docker setup).
SIDECAR_DOMAIN=e21.example.org

# Optional. E21_UPSTREAM is for a test system only; MyEditor must then be
# started with MYEDITOR_MEMBERSHIP_UPSTREAM set to the same address.
# E21_UPSTREAM=https://verein.einundzwanzig.space
# SIDECAR_RATE_PER_MINUTE=60
# SIDECAR_INVOICES_PER_DAY=10
# SIDECAR_LOG_LEVEL=INFO
