#: nostr/blossom/errors.py:80
msgid "The upload didn’t finish: try again."
msgstr "Das Hochladen wurde nicht abgeschlossen: Versuche es erneut."

#: nostr/blossom/errors.py:145
msgid "Something went wrong with that media request, and nothing was lost: try again."
msgstr "Bei dieser Anfrage an den Medienserver ist etwas schiefgegangen, und nichts ging verloren: Versuche es erneut."

#: nostr/blossom/errors.py:149
#, python-brace-format
msgid "Your signer app declined the request to the media server: {reason}"
msgstr "Deine Signer-App hat die Anfrage an den Medienserver abgelehnt: {reason}"

